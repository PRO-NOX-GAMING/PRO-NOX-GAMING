.stat{width:200px;padding:25px;text-align:center;background:#151515;border-radius:12px;border:1px solid #333}
.stat h2{color:#00e5ff;margin:0;font-size:35px}.stat p{color:#aaa}
section{padding:90px 30px;text-align:center}
section>h2{font-size:40px;color:#00e5ff;text-shadow:0 0 12px #00e5ff}
.cards,.video-container{display:flex;justify-content:center;flex-wrap:wrap;gap:25px;margin-top:40px}
.card{width:280px;padding:35px 20px;background:#111;border:1px solid #333;border-radius:15px;transition:.4s}
.card:hover{transform:translateY(-12px);border-color:#00e5ff;box-shadow:0 0 25px #00e5ff}
.emoji{font-size:55px}.card h3{font-size:25px}.card p{color:#aaa;line-height:1.5}
.videos{background:#0c0c0c}
