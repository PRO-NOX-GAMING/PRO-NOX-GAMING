.about p{max-width:750px;margin:auto;color:#bbb;line-height:1.8;font-size:18px}
footer{padding:30px;text-align:center;background:#020202;color:#777}
@media(max-width:700px){header{flex-direction:column;padding:15px}nav{margin-top:10px}nav a{margin:0 5px;font-size:13px}.hero h1{font-size:43px}}
