.button{display:inline-block;margin:10px;padding:15px 30px;border-radius:8px;text-decoration:none;font-weight:bold;transition:.3s;z-index:2}
.youtube{background:red;color:white}.youtube:hover{background:white;color:red;transform:scale(1.1)}
